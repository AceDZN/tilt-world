{
  "name": "tilt-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5242 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4242 --strictPort",
    "test": "tsx --test tests/*.test.ts",
    "shots": "node scripts/shots.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:embed": "node tests/host-embed.mjs",
    "poster": "node scripts/poster.mjs"
  },
  "dependencies": {
    "@fontsource/rubik": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.183.1",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
